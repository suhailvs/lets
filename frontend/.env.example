# Base URL of the Django API (where coinapp's api/urls.py is mounted).
# Leave as /api in development (Vite proxies it to VITE_BACKEND).
# For a production build served from another origin use a full URL, e.g.
# VITE_API_URL=https://example.com/api
VITE_API_URL=/api

# Dev proxy target (only used by `npm run dev`)
VITE_BACKEND=http://localhost:8000
